POSTGRES_OPS_PASSWORD=<postgres-ops-password>
S3_ACCESS_KEY=<s3-access-key>
S3_SECRET_KEY=<s3-secret-key>
TRINO_SHARED_SECRET=<same-random-secret-on-every-trino-node>
