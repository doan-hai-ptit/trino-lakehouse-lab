# Sao chép file này thành .env và thay toàn bộ giá trị placeholder.
# Không commit file .env hoặc dùng lại các giá trị này ở môi trường khác.

# PostgreSQL lưu metadata của Hive Metastore.
POSTGRES_METASTORE_PASSWORD=<replace-with-a-strong-password>

# PostgreSQL chứa dữ liệu vận hành dùng bởi catalog postgres_ops.
POSTGRES_OPS_PASSWORD=<replace-with-a-different-strong-password>

# Tài khoản root của MinIO và static S3 credential của Trino/Hive Metastore.
S3_ACCESS_KEY=<replace-with-an-access-key>
S3_SECRET_KEY=<replace-with-a-secret-key-at-least-8-characters>

# Chuỗi ngẫu nhiên giống hệt nhau trên coordinator và mọi worker Trino.
# Có thể tạo bằng: openssl rand -base64 48
TRINO_SHARED_SECRET=<replace-with-a-long-random-secret>
