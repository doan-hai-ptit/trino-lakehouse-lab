{
  "catalogs": [
    {
      "role": "admin",
      "catalog": "(mysql|system|iceberg)",
      "allow": "all"
    },
    {
      "catalog": "hive",
      "allow": "all"
    },
    {
      "group": "data_engineering",
      "catalog": "iceberg",
      "allow": "all"
    },
    {
      "group": "data_science",
      "catalog": "iceberg",
      "allow": "all"
    },
    {
      "group": "data_analytics",
      "catalog": "iceberg",
      "allow": "all"
    },
    {
      "catalog": "system",
      "allow": "none"
    }
  ],
  "schemas": [
    {
      "role": "admin",
      "schema": ".*",
      "owner": true
    },
    {
      "group": "data_engineering",
      "schema": "bronze|silver",
      "owner": true
    },
    {
      "catalog": "default",
      "schema": "default",
      "owner": true
    }
  ],
  "tables": [
    {
      "group": "data_engineering",
      "catalog": "iceberg",
      "schema": "bronze|silver",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE"]
    },
    {
      "group": "data_analytics",
      "catalog": "iceberg",
      "schema": "mart|quality",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE"]
    }
  ]
}