{
  "catalogs": [
    {
      "user": "admin",
      "catalog": ".*",
      "allow": "all"
    },
    {
      "catalog": "hive",
      "allow": "all"
    },
    {
      "group": "data_engineering",
      "catalog": "iceberg",
      "allow": "all"
    },
    {
      "group": "data_science",
      "catalog": "iceberg",
      "allow": "all"
    },
    {
      "group": "data_analytics",
      "catalog": "iceberg|postgres_ops",
      "allow": "all"
    },
    {
      "catalog": "system",
      "allow": "none"
    }
  ],
  "schemas": [
    {
      "user": "admin",
      "catalog": ".*",
      "schema": ".*",
      "owner": true
    },
    {
      "group": "data_engineering",
      "schema": "bronze|silver",
      "owner": true
    }
  ],
  "tables": [
    {
      "user": "admin",
      "catalog": ".*",
      "schema": ".*",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP", "GRANT_SELECT"]
    },
    {
      "group": "data_engineering",
      "catalog": "iceberg",
      "schema": "bronze|silver",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE"]
    },
    {
      "group": "data_analytics",
      "catalog": "iceberg|postgres_ops",
      "schema": "mart|quality|ops",
      "table": ".*",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE"]
    }
  ]
}